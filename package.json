{
  "name": "bundle-widget-app",
  "version": "1.0.0",
  "description": "Shopify bundle widget app — tracks browse behaviour and converts it into discounted bundles.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run build:dashboard",
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "db:migrate": "node src/db/migrate.js",
    "postinstall": "node src/db/ensure-env.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.12.0"
  },
  "license": "MIT"
}
